--- /dev/null
+++ b/docs/utilities/bc-cold-diagnostics.md
@@ -0,0 +1,12 @@
+# Cold diagnostic separation
+
+Refs #202 and #197. This candidate asks GCC/Clang to place arithmetic and VM
+fatal formatting off the success path and avoid inlining it. MSVC receives its
+noinline hint; other compilers retain the ordinary noreturn definition. Entry
+validation, runtime semantic errors, diagnostic arguments, streams, source
+locations and exit status remain active and unchanged. There are no unchecked
+assumptions or new runtime/compiler requirements.
+
+This is an experiment until actual code size, all-class matched release timing
+and native evidence support a decision. Fewer formatting bodies or ownership
+operations alone do not establish a runtime improvement.
diff --git a/src/bc/compiler-hints.hh b/src/bc/compiler-hints.hh
new file mode 100644
index 0000000..59b3877
--- /dev/null
+++ b/src/bc/compiler-hints.hh
@@ -0,0 +1,19 @@
+/** \file compiler-hints.hh
+ * Optional code-placement hints with a portable semantic fallback.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#ifndef GD_BC_COMPILER_HINTS_HH
+#define GD_BC_COMPILER_HINTS_HH
+
+// Keep diagnostic formatting out of successful arithmetic/VM execution. These
+// hints change neither the checked conditions nor the reported diagnostics.
+// Compilers without supported hints retain the ordinary noreturn function.
+#if defined(__GNUC__) || defined(__clang__)
+#  define GD_BC_COLD_DIAGNOSTIC __attribute__((cold, noinline))
+#elif defined(_MSC_VER)
+#  define GD_BC_COLD_DIAGNOSTIC __declspec(noinline)
+#else
+#  define GD_BC_COLD_DIAGNOSTIC
+#endif
+
+#endif
